# Wan2GP (WanGP) - Project aliases and functions
# All commands defined here, sourced by .salias
# Run 'help' to see all available commands

# ── Environment ──
set -gx ENV_NAME '.venv'
set -gx PYTHON_VERSION '3.11.14'

# ── Python Environment ──
# Deliberately NOT using the repo's setup.py / scripts/install.sh: setup.py runs
# `uv pip install` without --no-config, so the global ~/.config/uv/uv.toml
# `exclude-newer = "7 days"` applies and silently installs nothing (see install).
alias rmenv='rm -rf .envrc $ENV_NAME uv.lock; exit'
alias mkenv='mkuv $ENV_NAME $PYTHON_VERSION'

function install
   clear
   # --no-config lifts the global ~/.config/uv/uv.toml `exclude-newer = "7 days"`
   # supply-chain cutoff, which otherwise makes this project uninstallable:
   #   1. uv drops every file from an index that serves no upload dates, and
   #      neither download.pytorch.org nor the ort-cuda nightly feed at the top
   #      of requirements.txt has them -- so torch resolves to nothing.
   #   2. upstream tracks mmgp closely; a release published today is inside the
   #      7-day blackout.
   # Pushing --exclude-newer to a future date does NOT fix (1) -- missing upload
   # dates are excluded regardless of the cutoff. Only --no-config works.
   uv pip install --no-config pip
   # Pin all three as a matched set -- torchvision/torchaudio are built against a
   # specific torch ABI, and letting either float resolves to a newer build that
   # fails on import with an undefined-symbol error.
   uv pip install --no-config torch==2.10.0 torchvision==0.25.0 torchaudio==2.10.0 --index-url https://download.pytorch.org/whl/cu130
   uv pip install --no-config -r requirements.txt
   fixenv
   installsage
end

# ── SageAttention 2 (the `sage2` attention mode) ──
# Deliberately a separate step: it COMPILES CUDA kernels and takes a few minutes,
# so it is also runnable on its own after a failed or skipped build.
#
# requirements.txt does NOT list sageattention -- it is an optional accelerator,
# so a plain `install` leaves wgp_config.json pointing at a `sage2` that isn't
# there. That failure is SILENT and costs hours: generate_media hits its
# "attention mode not installed" branch, sends an info toast, and `return True`,
# so the queue marks the task SUCCESSFUL and no video is produced -- no
# traceback, nothing in journalctl, nothing in outputs/.
#
# It must be a SOURCE build of thu-ml/SageAttention (2.2.0). PyPI's
# `sageattention` is 1.0.6, and shared/attention.py gates the mode on
# version("sageattention").startswith("2"), so the wheel can never enable sage2.
set -gx SAGE_SRC "$HOME/.cache/wan2gp-build/SageAttention"

function installsage
   if not test -x /opt/cuda/bin/nvcc
      echo "installsage: /opt/cuda/bin/nvcc missing -- pacman -S cuda, then rerun."
      return 1
   end
   # --no-build-isolation is REQUIRED: the extension must link against the venv's
   # own torch 2.10/cu130. With isolation uv builds against a scratch torch it
   # downloads itself, and the resulting .so fails to import (undefined symbol).
   # That also means the build deps have to be present in the venv up front.
   uv pip install --no-config setuptools wheel packaging; or return 1
   if test -d $SAGE_SRC
      git -C $SAGE_SRC pull --ff-only
   else
      git clone --depth 1 https://github.com/thu-ml/SageAttention.git $SAGE_SRC; or return 1
   end
   # Build only this machine's GPU arch -- codegen for every supported
   # architecture takes roughly ten times as long for kernels we'd never run.
   set -l cap (nvidia-smi --query-gpu=compute_cap --format=csv,noheader | head -1 | string trim)
   echo "Building SageAttention 2 for compute capability $cap (several minutes)..."
   # LD_LIBRARY_PATH unset for the same reason as fixenv -- /opt/cuda's libs must
   # never shadow torch's vendored CUDA, at build time or at run time.
   # VIRTUAL_ENV is passed explicitly because `env` starts from a bare
   # environment here and uv would otherwise not know which venv to target.
   # -std=c++20 is LOAD-BEARING. SageAttention's setup.py compiles at c++17, and
   # under nvcc 13.3 that combination cannot parse torch 2.10's own headers:
   #   ATen/core/List_inl.h:202: error: need 'typename' before
   #   'decltype(...)::difference_type' ... is a dependent scope
   # The line already HAS `typename`; nvcc's frontend loses it at c++17. The
   # error names a torch header and appears only after pages of successful ptxas
   # output, so it reads like a broken toolchain -- it isn't. Bumping to c++20
   # fixes it outright, on every host gcc (14, 15 and 16 all pass).
   # *_APPEND_FLAGS are setup.py's own env hooks; the appended -std lands after
   # its built-in -std=c++17 and the last one wins.
   env -u LD_LIBRARY_PATH VIRTUAL_ENV=$PWD/$ENV_NAME CUDA_HOME=/opt/cuda \
       TORCH_CUDA_ARCH_LIST=$cap MAX_JOBS=(nproc) \
       CXX_APPEND_FLAGS="-std=c++20" NVCC_APPEND_FLAGS="-std=c++20" \
       uv pip install --no-config --no-build-isolation $SAGE_SRC; or return 1
   checksage
end

# Verifies sage2 is SELECTABLE, not merely importable: wgp additionally requires
# triton and compute capability >= 8.0, and drops the mode silently otherwise.
function checksage
   env -u LD_LIBRARY_PATH ./$ENV_NAME/bin/python -c 'import shared.attention as a; m = a.get_supported_attention_modes(); print("attention modes:", m); print("sage2 OK" if "sage2" in m else "sage2 MISSING")'
end

function fixenv
   # rmenv deletes .envrc and mkuv regenerates it WITHOUT this line. Without it
   # /opt/cuda's libcublasLt 13.6 shadows torch's vendored 13.1 (torch's wheels
   # use DT_RUNPATH, which loses to LD_LIBRARY_PATH) and the FIRST denoise step
   # dies with CUBLAS_STATUS_NOT_INITIALIZED -- looks like a model bug, isn't.
   if not grep -q 'unset LD_LIBRARY_PATH' .envrc
      echo 'unset LD_LIBRARY_PATH' >> .envrc
   end
   direnv allow .
end

# ── Service (systemd: wan-gpt.service, PortHub lease 7860, group wan2gp) ──
# Acts on this ONE unit, not the whole wan2gp group -- use `svcgroup wan2gp ...`
# or the dashboard at :8090 if you want the group.
alias run='systemctl --user start wan-gpt.service'
alias stop='systemctl --user stop wan-gpt.service'
alias restart='systemctl --user restart wan-gpt.service'
# 'status' is a fish reserved keyword and cannot be an alias -- hence sstatus.
alias sstatus='systemctl --user status wan-gpt.service --no-pager'
alias slog='journalctl --user -u wan-gpt.service --no-pager -n 50'
alias slogf='journalctl --user -u wan-gpt.service -f'

# Foreground run in this shell -- for debugging startup errors the service hides.
# LD_LIBRARY_PATH unset here too: direnv covers interactive shells, but this
# calls the venv python directly and must not inherit /opt/cuda/lib64.
function runf
   clear
   env -u LD_LIBRARY_PATH ./$ENV_NAME/bin/python wgp.py $argv
end

# gitupdate is intentionally NOT defined here — use the global fish function
# (~/.config/fish/functions/gitupdate.fish), which ff-only's main and rebases
# mryan on top. A local definition would shadow it on dir-entry.

# ── Help ──
# Relative path: .salias_f is always sourced with the project dir as PWD.
function help
    clear
    sed "s/PYTHON_VERSION/$PYTHON_VERSION/" ./.salias_help.txt
end
